# libFuzzer dictionary for the byte-oriented rinku-core autolink scanner.
# Keep entries ASCII; encode non-ASCII and control bytes as \xHH.

# URL schemes, domains, and complete links to reach parsing and rendering.
"http://"
"https://"
"ftp://"
"HTTP://"
"://"
"www."
"WWW."
"a.com"
"localhost"
"http://a.com"
"https://a.com/"
"ftp://a.com/"
"http://localhost"
"www.a.com"
"www.www."
"/"
"?q="
"#fragment"

# Email candidates and local-part characters.
"mailto:"
"a@b.com"
"a+b@d.com+e@f.com"
"a@b@c.com"
"@"
"."
"+"
"-"
"_"

# Default skip tags, attributes, ordinary tags, and malformed boundaries.
"<a>"
"</a>"
"<a href=\""
"<pre>"
"</pre>"
"<code>"
"</code>"
"<kbd>"
"</kbd>"
"<script>"
"</script>"
"<br>"
"<PRE>"
"</PRE>"
"<pre "
"<pre"
"<pre/>"
"<"
"</"
">"
"/>"

# Entity trimming, balanced delimiters, href quotes, and repeated trim passes.
"&amp;"
"&lt;"
"&gt;"
"&quot;"
"&#39;"
"&#x27;"
"&"
";"
"?"
"!"
","
"("
")"
"["
"]"
"{"
"}"
"\""
"'"
"))))))))"
"&lt;)&lt;)&lt;)&lt;)&lt;)&lt;)&lt;)"

# ASCII whitespace and NUL (also significant in local parts and trimming).
" "
"\x09"
"\x0A"
"\x0B"
"\x0C"
"\x0D"
"\x00"

# Recognized three-byte whitespace sequences, including range boundaries.
"\xE2\x80\x80"
"\xE2\x80\x8B"
"\xE2\x80\x8C"
"\xE2\x80\xA8"
"\xE2\x80\xA9"
"\xE2\x80\xAF"
"\xE2\x81\x9F"
"\xE3\x80\x80"
"\xEF\xBB\xBF"

# Non-whitespace Unicode, truncated sequences, and invalid UTF-8.
"\xC2\xA0"
"\xC3\xA9"
"\xE2\x80\x8D"
"\xE2"
"\xE2\x80"
"\xE2\x81"
"\xE3"
"\xE3\x80"
"\xEF"
"\xEF\xBB"
"\x80"
"\xFF"
